data/raw/

# Lab-internal profile: author names and commit subjects for everyone, not just
# consenting authors. Rendered locally, never deployed.
data/lab/
_site-lab/
data/cache/
data/tmp/

# Private local-only working-memory exports
.workmem/
private/working-memory/

# Node (only if we add dev tooling)
