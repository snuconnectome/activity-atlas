{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Activity Atlas Data Schema",
  "description": "Locked data contracts between Python pipeline and Quarto frontend. Changing these fields requires updating ALL consumers. Two tiers: `commit_raw` never leaves the local machine; `commit` is the redacted projection that is committed and published.",
  "version": "0.3.0",
  "definitions": {
    "commit_raw": {
      "type": "object",
      "description": "LOCAL ONLY: ACTIVITY_ATLAS_DATA_DIR/scopes/<scope>/raw/commits.json; full messages never published.",
      "required": [
        "sha",
        "org",
        "repo",
        "author_date",
        "message"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "description": "Git commit SHA (40 chars)"
        },
        "org": {
          "type": "string",
          "enum": [
            "snuconnectome",
            "Transconnectome",
            "neurox-org"
          ]
        },
        "repo": {
          "type": "string",
          "description": "Repo name without org prefix"
        },
        "author_date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "message": {
          "type": "string",
          "description": "Full commit message body; multiline. Carries unpublished paper titles and internal discussion for PRIVATE repos — this is why the raw tier exists."
        }
      }
    },
    "commit": {
      "description": "Public projection: named PUBLIC events or daily groups without repository identity. count defaults to 1 for event rows.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "org",
            "repo",
            "author_date",
            "domain",
            "wp",
            "repo_category"
          ],
          "properties": {
            "org": {
              "type": "string",
              "enum": [
                "snuconnectome",
                "Transconnectome",
                "neurox-org"
              ]
            },
            "author_date": {
              "type": "string",
              "format": "date-time"
            },
            "domain": {
              "type": "string"
            },
            "wp": {
              "type": "string"
            },
            "repo_category": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "repo": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "maxLength": 80
            },
            "event_id": {
              "type": "string"
            }
          },
          "dependencies": {
            "subject": [
              "sha"
            ]
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "org",
            "author_date",
            "domain",
            "wp",
            "repo_category",
            "count",
            "aggregate_only"
          ],
          "properties": {
            "org": {
              "type": "string",
              "enum": [
                "snuconnectome",
                "Transconnectome",
                "neurox-org"
              ]
            },
            "author_date": {
              "type": "string",
              "format": "date-time"
            },
            "domain": {
              "type": "string"
            },
            "wp": {
              "type": "string"
            },
            "repo_category": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "aggregate_only": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "topic": {
      "type": "object",
      "description": "One row per BERTopic cluster. Output of scripts/topic_model.py → data/pub/topics.json",
      "required": [
        "topic_id",
        "label",
        "top_words",
        "size",
        "color"
      ],
      "properties": {
        "topic_id": {
          "type": "integer",
          "description": "BERTopic-assigned ID; -1 = outlier cluster"
        },
        "label": {
          "type": "string",
          "description": "Human-curated label. See TODO(human) in scripts/topic_model.py"
        },
        "top_words": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "size": {
          "type": "integer",
          "description": "Number of commits in this cluster"
        },
        "color": {
          "type": "string",
          "description": "Okabe-Ito hex from palette"
        },
        "slot": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "embedding": {
      "type": "object",
      "description": "One row per commit's 2D UMAP projection. Output of scripts/topic_model.py → data/pub/embeddings.json",
      "required": [
        "sha",
        "x",
        "y",
        "topic_id"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "description": "Must match commit.sha"
        },
        "x": {
          "type": "number",
          "description": "UMAP dim 1"
        },
        "y": {
          "type": "number",
          "description": "UMAP dim 2"
        },
        "topic_id": {
          "type": "integer"
        },
        "event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "weekly_pulse": {
      "type": "object",
      "description": "One row per ISO week. Output of scripts/weekly_pulse.py → data/pub/weekly_pulse.json",
      "required": [
        "week_iso",
        "commit_count",
        "top_topics",
        "delta_bullets"
      ],
      "properties": {
        "week_iso": {
          "type": "string",
          "pattern": "^[0-9]{4}-W[0-9]{2}$",
          "description": "e.g. 2026-W18"
        },
        "commit_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_topics": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 3,
          "description": "topic_id values"
        },
        "delta_bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule-based diff strings, e.g. '+3 commits in neurox-org/foo'"
        }
      },
      "additionalProperties": false
    },
    "topics_metadata": {
      "type": "object",
      "description": "Wrapped in data/pub/topics.json alongside the topic array, to record clustering provenance",
      "properties": {
        "clustering_method": {
          "type": "string",
          "enum": [
            "hdbscan",
            "kmeans_fallback"
          ]
        },
        "n_commits": {
          "type": "integer"
        },
        "model": {
          "type": "string",
          "description": "sentence-transformers model name"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
